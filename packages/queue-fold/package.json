{
  "name": "dsh-plugin-queue-fold",
  "version": "1.0.0",
  "description": "Make the queued-message strip expandable and collapsible",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanlr1/dsh-plugins.git",
    "directory": "packages/queue-fold"
  },
  "homepage": "https://github.com/Fanlr1/dsh-plugins/tree/main/packages/queue-fold#readme",
  "bugs": {
    "url": "https://github.com/Fanlr1/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "queue-fold"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
