{
  "name": "dsh-plugin-hw-monitor",
  "version": "1.0.0",
  "description": "Real-time hardware monitor (VRAM / RAM / GPU / CPU / CPU clock) shown beside the composer",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/index.js"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fanlr1/dsh-plugins.git",
    "directory": "packages/hw-monitor"
  },
  "homepage": "https://github.com/Fanlr1/dsh-plugins/tree/main/packages/hw-monitor#readme",
  "bugs": {
    "url": "https://github.com/Fanlr1/dsh-plugins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hw-monitor"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
